{
  "ingestion": {
    "version": "1.0.0",
    "sources": {
      "workspace_root": "../..",
      "exclude": [
        "**/.git/**",
        "**/node_modules/**",
        "**/dist/**",
        "**/.vscode/**",
        "**/.cursor/**",
        "**/.devin/**",
        "**/.venv/**",
        "**/venv/**",
        "**/nul",
        "**/NUL",
        "**/nul.*"
      ],
      "max_file_size_mb": 5
    },
    "metadata": {
      "workspace": "${workspaceBasename}"
    }
  },
  "beacon": {
    "enabled": true,
    "log_path": "%USERPROFILE%/.beacon/endpoint/logs/runtime.jsonl",
    "max_sessions": 20
  }
}